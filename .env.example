# =====================================================================
# PlacementMonitor Environment Configuration Template
# Copy this file to '.env' and fill in your private credentials.
# NEVER commit the '.env' file to version control.
# =====================================================================

# Telegram Bot Configuration
# Obtain your Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Obtain your numeric Chat ID from @userinfobot or @raw_data_bot on Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Monitored Gmail Inboxes
# Mailbox 1: Personal Gmail monitored for eligibility phrases
MAILBOX1=your_first_email@gmail.com
# Mailbox 2: College/University Gmail monitored for shortlist identifiers and Excel attachments
MAILBOX2=your_second_email@gmail.com

# Candidate Identifiers for Shortlist & Eligibility Matching
# Registration Number (e.g., college roll number or student ID)
REGISTRATION_NUMBER=your_registration_number_here
# NeoPat / Assessment Portal ID (e.g., student portal ID)
NEOPAT_ID=your_neopat_id_here

# Monitoring Loop Interval (in seconds, e.g., 300 for 5 minutes, 10 for rapid polling)
CHECK_INTERVAL=300
